@Html.EJS().Spreadsheet("spreadsheet").ShowFormulaBar(false).AllowFormControl(true).Sheets(sheet =>
{
    sheet.Name("FormControls").Rows(row =>
    {
        row.Cells(cell =>
        {
            cell.Value("Form Controls Demo").Style(new SpreadsheetCellStyle() { FontWeight = FontWeight.Bold, TextAlign = TextAlign.Center }).Add();
        }).Add();
        
        row.Cells(cell =>
        {
            cell.Value("Radio Button Control").Add();
            cell.Value("").Add();
            cell.Value("Cell Link").Add();
            cell.Value("").Add();
        }).Add();
        
        row.Cells(cell =>
        {
            cell.Value("Option 2").Add();
            cell.Value("").Add();
            cell.Value("Cell Link").Add();
            cell.Value("").Add();
        }).Add();
        
        row.Cells(cell =>
        {
            cell.Value("Option 3").Add();
            cell.Value("").Add();
            cell.Value("Cell Link").Add();
            cell.Value("").Add();
        }).Add();
    }).Columns(column =>
    {
        column.Width(150).Add();
        column.Width(150).Add();
        column.Width(150).Add();
        column.Width(150).Add();
    }).FormControls(formControl =>
    {
        formControl.Type("RadioButton").Text("Option 1").CellLink("D2").Value("Unchecked").Top(40).Left(150).Height(20).Width(120).Add();
        formControl.Type("RadioButton").Text("Option 2").CellLink("D4").Value("Unchecked").Top(80).Left(150).Height(20).Width(120).Add();
        formControl.Type("RadioButton").Text("Option 3").CellLink("D6").Value("Unchecked").Top(120).Left(150).Height(20).Width(120).Add();
    }).Add();
}).Render()
